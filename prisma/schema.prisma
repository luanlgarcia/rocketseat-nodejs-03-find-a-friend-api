// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

enum Age {
  PUPPY
  ADULT
  SENIOR
}

enum Size {
  SMALL
  MEDIUM
  LARGE
}

enum EnergyLevel {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum IndependenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum Environment {
  SMALL
  MEDIUM
  SPACIOUS
}

model Org {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  created_at    DateTime @default(now())
  role          Role     @default(MEMBER)
  city          String
  address       String
  whats_app     Int

  pets Pets[]

  @@map("orgs")
}

model Pets {
  id                 String            @id @default(uuid())
  creted_at          DateTime          @default(now())
  name               String
  description        String?
  age                Age
  size               Size
  energy_level       EnergyLevel
  independence_level IndependenceLevel
  environment        Environment

  org    Org    @relation(fields: [org_id], references: [id])
  org_id String

  @@map("pets")
}
